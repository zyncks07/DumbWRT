# logrotate config for the OpenWrt Monitor collector.
# Install: sudo install -m644 system/openwrt-monitor.logrotate /etc/logrotate.d/openwrt-monitor
#
# `copytruncate` is mandatory because ubus_collector.py uses a plain
# logging.FileHandler which holds the descriptor open — renaming the
# log would leave the daemon writing to the renamed file.
#
# Steady state: ~5 MB live + ~5 MB uncompressed rotation + ~4×1 MB gz
# ≈ 14 MB max disk under /var/log/.

/var/log/openwrt-collector.log {
    size 5M
    rotate 5
    compress
    delaycompress
    notifempty
    missingok
    copytruncate
}
