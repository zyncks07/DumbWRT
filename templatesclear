<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OpenWrt Monitor Dashboard</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(135deg, #0a0e27 0%, #0d1117 100%);
            color: #e8eaed;
            min-height: 100vh;
            padding: 15px;
        }
        
        .header {
            background: rgba(26, 34, 56, 0.95);
            border: 1px solid rgba(0, 212, 255, 0.2);
            border-radius: 12px;
            padding: 20px 30px;
            margin-bottom: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .header h1 {
            font-size: 24px;
            background: linear-gradient(135deg, #00d4ff, #00ff88);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        
        .header-actions {
            display: flex;
            gap: 10px;
            align-items: center;
        }
        
        .last-update {
            font-size: 11px;
            color: #9aa0a6;
            margin-right: 15px;
        }
        
        .btn {
            background: rgba(26, 34, 56, 0.95);
            border: 1px solid rgba(0, 212, 255, 0.3);
            color: #e8eaed;
            padding: 10px 18px;
            border-radius: 8px;
            text-decoration: none;
            font-size: 13px;
            transition: all 0.3s;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
        }
        
        .btn:hover {
            background: #00d4ff;
            border-color: #00d4ff;
            color: #0a0e27;
            transform: translateY(-2px);
        }
        
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin-bottom: 20px;
        }
        
        .stat-card {
            background: rgba(26, 34, 56, 0.95);
            border: 1px solid rgba(0, 212, 255, 0.2);
            border-radius: 12px;
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }
        
        .stat-label {
            font-size: 11px;
            color: #9aa0a6;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 600;
        }
        
        .stat-value {
            font-size: 32px;
            font-weight: 700;
            background: linear-gradient(135deg, #00d4ff, #00ff88);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        
        .stat-icon {
            font-size: 20px;
            opacity: 0.3;
        }
        
        .routers-grid {
            display: grid;
            gap: 15px;
        }
        
        .router-card {
            background: rgba(26, 34, 56, 0.95);
            border: 1px solid rgba(0, 212, 255, 0.2);
            border-radius: 12px;
            overflow: hidden;
            transition: all 0.3s;
        }
        
        .router-card.offline {
            opacity: 0.5;
            border-color: rgba(255, 71, 87, 0.3);
        }
        
        .router-header {
            padding: 20px;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: all 0.3s;
        }
        
        .router-header:hover {
            background: rgba(0, 212, 255, 0.05);
        }
        
        .router-info {
            display: flex;
            align-items: center;
            gap: 15px;
        }
        
        .router-status {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: #00ff88;
            box-shadow: 0 0 10px rgba(0, 255, 136, 0.5);
            animation: pulse 2s infinite;
        }
        
        .router-status.offline {
            background: #ff4757;
            box-shadow: 0 0 10px rgba(255, 71, 87, 0.5);
            animation: none;
        }
        
        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }
        
        .router-name {
            font-size: 16px;
            font-weight: 600;
            color: #00d4ff;
        }
        
        .router-ip {
            font-size: 11px;
            color: #9aa0a6;
            font-family: 'Courier New', monospace;
        }
        
        .router-stats {
            display: flex;
            gap: 20px;
            align-items: center;
        }
        
        .router-stat {
            text-align: center;
        }
        
        .router-stat-value {
            font-size: 20px;
            font-weight: 700;
            color: #00d4ff;
        }
        
        .router-stat-label {
            font-size: 9px;
            color: #9aa0a6;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        
        .router-content {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease-out;
        }
        
        .router-content.expanded {
            max-height: 2000px;
        }
        
        .interfaces-list {
            padding: 0 20px 20px;
        }
        
        .interface-card {
            background: rgba(10, 14, 39, 0.7);
            border: 1px solid rgba(0, 212, 255, 0.1);
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 15px;
        }
        
        .interface-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }
        
        .interface-name {
            font-size: 13px;
            font-weight: 600;
            color: #00ff88;
            font-family: 'Courier New', monospace;
        }
        
        .interface-ssid {
            font-size: 14px;
            font-weight: 600;
            color: #e8eaed;
        }
        
        .interface-meta {
            display: flex;
            gap: 15px;
            font-size: 11px;
            color: #9aa0a6;
            margin-bottom: 15px;
        }
        
        .clients-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 11px;
        }
        
        .clients-table th {
            text-align: left;
            padding: 8px;
            background: rgba(0, 212, 255, 0.1);
            color: #9aa0a6;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-size: 10px;
        }
        
        .clients-table td {
            padding: 10px 8px;
            border-top: 1px solid rgba(0, 212, 255, 0.1);
        }
        
        .clients-table tr:hover {
            background: rgba(0, 212, 255, 0.05);
        }
        
        .mac-address {
            font-family: 'Courier New', monospace;
            color: #00d4ff;
            font-size: 11px;
        }
        
        .signal-bar {
            display: inline-block;
            width: 60px;
            height: 8px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 4px;
            overflow: hidden;
            vertical-align: middle;
            margin-right: 8px;
        }
        
        .signal-fill {
            height: 100%;
            border-radius: 4px;
            transition: all 0.3s;
        }
        
        .signal-excellent { background: linear-gradient(90deg, #00ff88, #00d4ff); }
        .signal-good { background: linear-gradient(90deg, #ffd93d, #00ff88); }
        .signal-fair { background: linear-gradient(90deg, #ffb830, #ffd93d); }
        .signal-poor { background: linear-gradient(90deg, #ff4757, #ffb830); }
        
        .rate {
            font-family: 'Courier New', monospace;
            color: #e8eaed;
        }
        
        .no-clients {
            text-align: center;
            padding: 30px;
            color: #9aa0a6;
            font-size: 12px;
        }
        
        .loading {
            text-align: center;
            padding: 50px;
            color: #9aa0a6;
        }
        
        .spinner {
            border: 3px solid rgba(255, 255, 255, 0.1);
            border-top: 3px solid #00d4ff;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            animation: spin 1s linear infinite;
            margin: 0 auto 20px;
        }
        
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        
        .expand-icon {
            transition: transform 0.3s;
        }
        
        .expand-icon.rotated {
            transform: rotate(180deg);
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>
            <i class="fas fa-network-wired"></i>
            OpenWrt Monitor
        </h1>
        <div class="header-actions">
            <div class="last-update" id="lastUpdate">Last update: Never</div>
            <a href="/config" class="btn">
                <i class="fas fa-cog"></i>
                Settings
            </a>
            <a href="/logout" class="btn">
                <i class="fas fa-sign-out-alt"></i>
                Logout
            </a>
        </div>
    </div>

    <div class="stats-grid" id="statsGrid">
        <div class="stat-card">
            <div class="stat-label">
                <i class="fas fa-router stat-icon"></i>
                Total Routers
            </div>
            <div class="stat-value" id="totalRouters">0</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">
                <i class="fas fa-check-circle stat-icon"></i>
                Online Routers
            </div>
            <div class="stat-value" id="onlineRouters">0</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">
                <i class="fas fa-wifi stat-icon"></i>
                Total Interfaces
            </div>
            <div class="stat-value" id="totalInterfaces">0</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">
                <i class="fas fa-users stat-icon"></i>
                Total Clients
            </div>
            <div class="stat-value" id="totalClients">0</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">
                <i class="fas fa-signal stat-icon"></i>
                2.4GHz Clients
            </div>
            <div class="stat-value" id="clients24">0</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">
                <i class="fas fa-signal stat-icon"></i>
                5GHz Clients
            </div>
            <div class="stat-value" id="clients5">0</div>
        </div>
    </div>

    <div class="routers-grid" id="routersGrid">
        <div class="loading">
            <div class="spinner"></div>
            <div>Loading router data...</div>
        </div>
    </div>

    <script>
        let expandedRouters = new Set();

        function getSignalClass(signal) {
            if (signal >= -50) return 'signal-excellent';
            if (signal >= -60) return 'signal-good';
            if (signal >= -70) return 'signal-fair';
            return 'signal-poor';
        }

        function getSignalPercent(signal) {
            // Convert dBm to percentage (rough approximation)
            // -30 dBm = 100%, -90 dBm = 0%
            const percent = Math.max(0, Math.min(100, ((signal + 90) / 60) * 100));
            return percent;
        }

        function formatRate(rate) {
            if (!rate || rate === 0) return '-';
            if (rate >= 1000) return (rate / 1000).toFixed(1) + ' Gbps';
            return rate + ' Mbps';
        }

        function formatBytes(bytes) {
            if (!bytes || bytes === 0) return '0 B';
            const k = 1024;
            const sizes = ['B', 'KB', 'MB', 'GB', 'TB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return Math.round(bytes / Math.pow(k, i) * 100) / 100 + ' ' + sizes[i];
        }

        function formatTime(seconds) {
            if (!seconds) return '0s';
            const h = Math.floor(seconds / 3600);
            const m = Math.floor((seconds % 3600) / 60);
            const s = seconds % 60;
            if (h > 0) return `${h}h ${m}m`;
            if (m > 0) return `${m}m ${s}s`;
            return `${s}s`;
        }

        function toggleRouter(routerIp) {
            if (expandedRouters.has(routerIp)) {
                expandedRouters.delete(routerIp);
            } else {
                expandedRouters.add(routerIp);
            }
            renderRouters();
        }

        function renderRouters() {
            fetch('/api/routers')
                .then(res => res.json())
                .then(data => {
                    const routers = data.routers || [];
                    const grid = document.getElementById('routersGrid');
                    
                    if (routers.length === 0) {
                        grid.innerHTML = '<div class="no-clients">No routers configured. Please add routers in Settings.</div>';
                        return;
                    }

                    grid.innerHTML = routers.map(router => {
                        const isExpanded = expandedRouters.has(router.ip);
                        const isOnline = router.online === 1;
                        
                        return `
                            <div class="router-card ${!isOnline ? 'offline' : ''}">
                                <div class="router-header" onclick="toggleRouter('${router.ip}')">
                                    <div class="router-info">
                                        <div class="router-status ${!isOnline ? 'offline' : ''}"></div>
                                        <div>
                                            <div class="router-name">${router.hostname || router.ip}</div>
                                            <div class="router-ip">${router.ip}</div>
                                        </div>
                                    </div>
                                    <div class="router-stats">
                                        <div class="router-stat">
                                            <div class="router-stat-value">${router.num_interfaces || 0}</div>
                                            <div class="router-stat-label">Interfaces</div>
                                        </div>
                                        <div class="router-stat">
                                            <div class="router-stat-value">${router.total_clients || 0}</div>
                                            <div class="router-stat-label">Clients</div>
                                        </div>
                                        <i class="fas fa-chevron-down expand-icon ${isExpanded ? 'rotated' : ''}" style="color: #00d4ff;"></i>
                                    </div>
                                </div>
                                <div class="router-content ${isExpanded ? 'expanded' : ''}" id="router-${router.ip}">
                                    <div class="loading">
                                        <div class="spinner"></div>
                                        Loading interfaces...
                                    </div>
                                </div>
                            </div>
                        `;
                    }).join('');

                    // Load interface details for expanded routers
                    routers.forEach(router => {
                        if (expandedRouters.has(router.ip)) {
                            loadRouterDetails(router.ip);
                        }
                    });
                })
                .catch(err => {
                    console.error('Error fetching routers:', err);
                });
        }

        function loadRouterDetails(routerIp) {
            fetch(`/api/router/${routerIp}`)
                .then(res => res.json())
                .then(data => {
                    const interfaces = data.interfaces || [];
                    const container = document.getElementById(`router-${routerIp}`);
                    
                    if (interfaces.length === 0) {
                        container.innerHTML = '<div class="no-clients">No wireless interfaces found</div>';
                        return;
                    }

                    container.innerHTML = `
                        <div class="interfaces-list">
                            ${interfaces.map(iface => `
                                <div class="interface-card">
                                    <div class="interface-header">
                                        <div>
                                            <div class="interface-ssid">${iface.ssid || 'Hidden SSID'}</div>
                                            <div class="interface-name">${iface.interface}</div>
                                        </div>
                                        <div style="text-align: right; font-size: 11px; color: #9aa0a6;">
                                            <div><strong>${iface.num_clients || 0}</strong> clients</div>
                                        </div>
                                    </div>
                                    <div class="interface-meta">
                                        <span><i class="fas fa-signal"></i> ${iface.frequency ? (iface.frequency / 1000).toFixed(1) + ' GHz' : 'N/A'}</span>
                                        <span><i class="fas fa-arrows-alt-h"></i> ${iface.bandwidth || 'N/A'} MHz</span>
                                        <span><i class="fas fa-broadcast-tower"></i> Ch ${iface.channel || 'N/A'}</span>
                                        <span><i class="fas fa-lock"></i> ${iface.encryption || 'Open'}</span>
                                    </div>
                                    ${(iface.clients && iface.clients.length > 0) ? `
                                        <table class="clients-table">
                                            <thead>
                                                <tr>
                                                    <th>MAC Address</th>
                                                    <th>Signal</th>
                                                    <th>RX Rate</th>
                                                    <th>TX Rate</th>
                                                    <th>RX/TX Data</th>
                                                    <th>Connected</th>
                                                    <th>Inactive</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                ${iface.clients.map(client => {
                                                    const signalPercent = getSignalPercent(client.signal);
                                                    const signalClass = getSignalClass(client.signal);
                                                    
                                                    return `
                                                        <tr>
                                                            <td class="mac-address">${client.mac}</td>
                                                            <td>
                                                                <div class="signal-bar">
                                                                    <div class="signal-fill ${signalClass}" style="width: ${signalPercent}%"></div>
                                                                </div>
                                                                ${client.signal} dBm
                                                            </td>
                                                            <td class="rate">${formatRate(client.rx_rate)}</td>
                                                            <td class="rate">${formatRate(client.tx_rate)}</td>
                                                            <td class="rate">${formatBytes(client.rx_bytes)} / ${formatBytes(client.tx_bytes)}</td>
                                                            <td>${formatTime(client.connected_time)}</td>
                                                            <td>${client.inactive ? client.inactive + 's' : 'Active'}</td>
                                                        </tr>
                                                    `;
                                                }).join('')}
                                            </tbody>
                                        </table>
                                    ` : '<div class="no-clients">No clients connected</div>'}
                                </div>
                            `).join('')}
                        </div>
                    `;
                })
                .catch(err => {
                    console.error(`Error fetching details for ${routerIp}:`, err);
                    const container = document.getElementById(`router-${routerIp}`);
                    container.innerHTML = '<div class="no-clients">Error loading interface data</div>';
                });
        }

        function updateStats() {
            fetch('/api/stats')
                .then(res => res.json())
                .then(data => {
                    document.getElementById('totalRouters').textContent = data.routers.total || 0;
                    document.getElementById('onlineRouters').textContent = data.routers.online || 0;
                    document.getElementById('totalInterfaces').textContent = data.total_interfaces || 0;
                    document.getElementById('totalClients').textContent = data.clients_total || 0;
                    document.getElementById('clients24').textContent = data.clients_by_band['2.4GHz'] || 0;
                    document.getElementById('clients5').textContent = data.clients_by_band['5GHz'] || 0;
                    
                    const now = new Date();
                    document.getElementById('lastUpdate').textContent = 
                        `Last update: ${now.toLocaleTimeString()}`;
                })
                .catch(err => console.error('Error fetching stats:', err));
        }

        // Initial load
        renderRouters();
        updateStats();

        // Auto-refresh every 10 seconds
        setInterval(() => {
            renderRouters();
            updateStats();
        }, 10000);
    </script>
</body>
</html>
